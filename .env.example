DATABASE_URL=postgresql+psycopg2://contable_user:contable_pass@localhost:5432/contable_db
PROJECT_NAME=Sistema Contable
API_V1_PREFIX=/api/v1

# "desarrollo" o "produccion". Con ENTORNO=produccion la app se niega a
# arrancar si SECRET_KEY quedó con el valor de ejemplo de abajo.
ENTORNO=desarrollo

# Clave para firmar los JWT. Este valor está publicado en el repositorio:
# sirve para desarrollo, pero en producción hay que reemplazarlo por uno
# propio (`openssl rand -hex 32`) o cualquiera podría firmarse un token de
# admin válido.
SECRET_KEY=dev-secret-key-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
